---
import ghibliProfile from '../assets/images/ghibli-profile.webp';
import { institutions, type InstitutionId } from '../data/education';
import { organizations } from '../data/portfolio';
import { skillTopics } from '../data/skills';

const siteUrl = Astro.site || 'https://rigvedpatki.dev';
const personId = new URL('/#person', siteUrl).toString();
const profileImageUrl = new URL(ghibliProfile.src, siteUrl).toString();
const alumniInstitutionIds: InstitutionId[] = [
  'vit',
  'eit-digital',
  'tu-berlin',
  'kth',
  'aalto'
];

// Person Schema
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId,
  name: 'Rigved Patki',
  jobTitle: 'Senior Full-Stack Engineer',
  description:
    'Senior Full-Stack Engineer with 9+ years building reliable product experiences for enterprise cloud and data platforms. Specializing in frontend architecture, cloud-native systems, and technical leadership.',
  url: siteUrl.toString(),
  image: profileImageUrl,
  sameAs: [
    'https://www.linkedin.com/in/rigved-satish-patki/',
    'https://github.com/rigvedpatki'
  ],
  knowsAbout: [
    'Full Stack Development',
    ...skillTopics,
    'Software Architecture',
    'Scrum Master'
  ],
  worksFor: {
    '@type': 'Organization',
    name: organizations.cohesity.legalName
  },
  alumniOf: alumniInstitutionIds.map(institutionId => ({
    '@type': institutions[institutionId].schemaType,
    name: institutions[institutionId].name
  })),
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Master of Science in ICT Innovation: Cloud Computing and Services',
      credentialCategory: "Master's degree",
      recognizedBy: [
        {
          '@type': 'EducationalOrganization',
          name: institutions['eit-digital'].name
        },
        {
          '@type': 'CollegeOrUniversity',
          name: institutions['tu-berlin'].name
        },
        {
          '@type': 'CollegeOrUniversity',
          name: institutions.kth.name
        }
      ]
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Bachelor of Technology in Information Technology',
      credentialCategory: "Bachelor's degree",
      recognizedBy: {
        '@type': 'EducationalOrganization',
        name: institutions.vit.name
      }
    }
  ]
};

// WebSite Schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Rigved Patki - Portfolio',
  url: siteUrl.toString(),
  description: 'Portfolio website of Rigved Patki, Senior Full-Stack Engineer',
  author: {
    '@type': 'Person',
    '@id': personId
  }
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(personSchema)}
/>
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(websiteSchema)}
/>
