---
import ProjectsIcon from '../assets/icons/solid/projects.svg';
import { getRole, organizations, projectGroups } from '../data/portfolio';
---

<section
  id="projects"
  class="card bg-base-100 border border-base-300 shadow-sm"
>
  <div class="card-body">
    <h2 class="card-title text-2xl font-semibold flex items-center gap-3 mb-4">
      <ProjectsIcon
        class="h-7 w-7 shrink-0 fill-primary"
        aria-label="Projects icon"
      />
      Projects
    </h2>
    <div class="flex flex-col gap-y-4">
      {
        projectGroups.map(group => {
          const groupRoles = group.roleIds.map(getRole);
          const organizationNames = groupRoles.map(
            role => organizations[role.organizationId].name
          );

          return (
            <div class="flex flex-col gap-y-3">
              <div class="flex flex-col gap-y-1">
                <h3 class="text-lg font-semibold text-base-content">
                  {organizationNames.join(' & ')}
                </h3>
                <p class="text-sm text-base-content/70 italic">
                  {groupRoles.map(role => role.period.label).join(' | ')}
                </p>
              </div>

              {group.projects.map(project => (
                <div class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-4">
                  <div class="flex flex-col gap-y-2">
                    <div class="flex flex-col gap-y-1">
                      <h4 class="text-base font-semibold">{project.title}</h4>
                      <p class="text-sm font-medium text-base-content/80">
                        {project.subtitle}
                      </p>
                    </div>
                    <p class="text-sm text-base-content/80 leading-relaxed">
                      {project.narrative}
                    </p>
                    <ul class="ml-4 list-disc text-sm text-base-content/70 space-y-1">
                      {project.contributions.map(contribution => (
                        <li>{contribution}</li>
                      ))}
                    </ul>
                    <p class="text-xs text-base-content/60 mt-2">
                      <strong>Tech Stack:</strong>{' '}
                      {project.technologies.join(', ')}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
