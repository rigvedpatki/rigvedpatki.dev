---
import EducationIcon from '../assets/icons/solid/education.svg';
---

<div class="card bg-base-100 border border-base-300 shadow-sm">
  <div class="card-body">
    <h2 class="card-title text-xl font-semibold flex items-center gap-2 mb-4">
      <EducationIcon class="h-7 w-7 shrink-0 fill-primary" />
      Education
    </h2>
    <div class="flex flex-col gap-y-4">
      <div
        class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-3"
      >
        <div class="flex flex-col gap-y-1.5">
          <div class="flex flex-col gap-y-0.5">
            <h1 class="text-lg font-medium">
              Bachelor of Technology (B.Tech) in Information Technology
            </h1>
            <h2 class="text-base-content/70">
              Vishwakarma Institute of Technology, Pune
            </h2>
            <h2 class="text-base-content/70">Aug 2009 - May 2013</h2>
          </div>
          <div class="flex flex-col gap-y-1.5">
            <p class="text-base-content/70">
              Graduated with a CGPA of 7.56 out of 10
            </p>
            <p class="text-base-content/70">Academic Projects:</p>
            <ul class="ml-4 list-disc text-base-content/70">
              <li>
                IP Address Calculation for Class-full and CIDR IP addressing
              </li>
              <li>Using KNN algorithm in Data minning for a given data set</li>
              <li>
                LogMon - An application for collecting , searching and analyzing
                log files of all computers in a local area network
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div
        class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-3"
      >
        <div class="flex flex-col gap-y-1.5">
          <div class="flex flex-col gap-y-0.5">
            <h1 class="text-lg font-medium">
              Master of Science (M.Sc.) in ICT Innovation: Cloud Computing and
              Services
            </h1>
            <h2 class="text-base-content/70">Technische Universität Berlin</h2>
            <h2 class="text-base-content/70">Sep 2015 - Apr 2016</h2>
          </div>
          <div class="flex flex-col gap-y-1.5">
            <p class="text-base-content/70">
              In association with EIT Digital Master School
            </p>
            <p class="text-base-content/70">Academic Projects:</p>
            <ul class="ml-4 list-disc text-base-content/70">
              <li>Cloud based Employee Reimbursement Application</li>
              <li>
                JogAir - Application for collecting and displaying pollution
                data of Germany.
              </li>
              <li>
                Internet Service Lab - Graphical HATEOAS Representation for REST
                API Development.
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div
        class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-3"
      >
        <div class="flex flex-col gap-y-1.5">
          <div class="flex flex-col gap-y-0.5">
            <h1 class="text-lg font-medium">Summer School EIT Digital</h1>
            <h2 class="text-base-content/70">Aalto University, Finland</h2>
            <h2 class="text-base-content/70">Jun 2016</h2>
          </div>
          <div class="flex flex-col gap-y-1.5">
            <p class="text-base-content/70">
              In association with EIT Digital Master School
            </p>
          </div>
        </div>
      </div>
      <div
        class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-3"
      >
        <div class="flex flex-col gap-y-1.5">
          <div class="flex flex-col gap-y-0.5">
            <h1 class="text-lg font-medium">
              Master of Science (M.Sc.) in ICT Innovation: Cloud Computing and
              Services
            </h1>
            <h2 class="text-base-content/70">
              KTH Royal Institute of Technology, Stockholm
            </h2>
            <h2 class="text-base-content/70">Aug 2016 - May 2018</h2>
          </div>
          <div class="flex flex-col gap-y-1.5">
            <p class="text-base-content/70">
              In association with EIT Digital Master School
            </p>
            <p class="text-base-content/70">Academic Projects:</p>
            <ul class="ml-4 list-disc text-base-content/70">
              <li>Swedish Event Management System</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
