---
import CertificateIcon from '../assets/icons/solid/certificate.svg';
import { credentials } from '../data/credentials';
---

<section
  id="certifications"
  class="card bg-base-100 border border-base-300 shadow-sm"
>
  <div class="card-body">
    <h2 class="card-title text-2xl font-semibold flex items-center gap-3 mb-4">
      <CertificateIcon
        class="h-7 w-7 shrink-0 fill-primary"
        aria-label="Certificate icon"
      />
      Certifications
    </h2>
    <div class="flex flex-col gap-y-3">
      {
        credentials.map(credential => (
          <div class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-4">
            <div class="flex flex-col gap-y-1.5">
              <div class="flex flex-col gap-y-0.5">
                <h3 class="text-base font-semibold">{credential.title}</h3>
                <p class="text-sm text-base-content/70">
                  {credential.issuer} • {credential.issuedLabel}
                </p>
              </div>
              <p class="text-sm text-base-content/80 leading-relaxed">
                {credential.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
