---
import { Image } from 'astro:assets';
import SkillsIcon from '../assets/icons/solid/skills.svg';
import { skillCategories } from '../data/skills';
---

<section id="skills" class="card bg-base-100 border border-base-300 shadow-sm">
  <div class="card-body">
    <h2 class="card-title text-xl font-semibold flex items-center gap-2 mb-4">
      <SkillsIcon
        class="h-7 w-7 shrink-0 fill-primary"
        aria-label="Skills icon"
      />
      Skills
    </h2>
    <div class="flex flex-col gap-y-6">
      {
        skillCategories.map(category => (
          <div class="flex flex-col gap-y-2 md:flex-row md:gap-x-5 md:gap-y-0">
            <h3 class="w-1/5 font-medium text-base">{category.name}</h3>
            <div class="flex w-4/5 flex-row flex-wrap gap-x-4 gap-y-2">
              {category.skills.map(skill => {
                const iconSize = skill.iconSize ?? 24;

                return (
                  <div class="badge badge-lg gap-2 bg-base-200 text-base-content border-base-300 hover:bg-base-300 transition-all cursor-default">
                    <Image
                      src={skill.icon}
                      alt={skill.name}
                      width={iconSize}
                      height={iconSize}
                      class={
                        iconSize === 20
                          ? 'h-5 w-5 shrink-0'
                          : 'h-6 w-6 shrink-0'
                      }
                      loading="lazy"
                      fetchpriority={skill.fetchPriority}
                      decoding="async"
                    />
                    <p>{skill.name}</p>
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
