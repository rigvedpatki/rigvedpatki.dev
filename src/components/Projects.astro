---
import ProjectsIcon from '../assets/icons/solid/projects.svg';
---

<div class="card bg-base-100 border border-base-300 shadow-sm">
  <div class="card-body">
    <h2 class="card-title text-xl font-semibold flex items-center gap-2 mb-4">
      <ProjectsIcon class="h-7 w-7 shrink-0 fill-primary" />
      Projects
    </h2>
    <div
      class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-3"
    >
      <div class="flex flex-col gap-y-1.5">
        <ul class="ml-4 list-disc text-base-content/70">
          <li>
            System Health Insights - Analytics dashboard with frontend
            leadership
          </li><li>
            Support Engineer Triage Application - Full-stack web application for
            debugging customer defects
          </li>
          <li>
            Release Management Automation - CLI application to automate release
            management across 25+ microservices
          </li>
          <li>
            IoT Analytics Dashboard - Vue.js application for monitoring IoT
            devices
          </li>
          <li>
            MQTT Client - IoT data processing and storage solution with MongoDB
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
