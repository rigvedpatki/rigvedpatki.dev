---
import ExperienceIcon from '../assets/icons/solid/experience.svg';
---

<div class="card bg-base-100 border border-base-300 shadow-sm">
  <div class="card-body">
    <h2 class="card-title text-xl font-semibold flex items-center gap-2 mb-4">
      <ExperienceIcon class="h-7 w-7 shrink-0 fill-primary" />
      Experience
    </h2>
    <div class="flex flex-col gap-y-4">
      <div
        class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-3"
      >
        <div class="flex flex-col gap-y-1.5">
          <div class="flex flex-col gap-y-0.5">
            <h1 class="text-lg font-medium">Cohesity Inc, Pune</h1>
            <h2 class="text-base-content/70">Member of Technical Staff - 3</h2>
            <h2 class="text-base-content/70">Dec 2024 - Present</h2>
          </div>
          <ul class="ml-4 list-disc text-base-content/70">
            <li>
              Following the acquisition of Veritas Technologies LLC by Cohesity
              Inc, continuing the same responsibilities in frontend and
              full-stack development for System Health Insights
            </li>
          </ul>
        </div>
      </div>
      <div
        class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-3"
      >
        <div class="flex flex-col gap-y-1.5">
          <div class="flex flex-col gap-y-0.5">
            <h1 class="text-lg font-medium">Veritas Technologies LLC, Pune</h1>
            <h2 class="text-base-content/70">Senior Software Engineer</h2>
            <h2 class="text-base-content/70">Aug 2020 - Dec 2024</h2>
          </div>
          <ul class="ml-4 list-disc text-base-content/70">
            <li>
              Led frontend development for System Health Insights, an analytics
              dashboard
            </li>
            <li>
              Managed a Scrum team of 6-8 members, mentoring junior developers
            </li>
            <li>
              Developed a full-stack web application enabling support engineers
              to triage and debug customer defects
            </li>
            <li>
              Built a CLI application to automate release management across 25+
              microservices
            </li>
          </ul>
        </div>
      </div>
      <div
        class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-3"
      >
        <div class="flex flex-col gap-y-1.5">
          <div class="flex flex-col gap-y-0.5">
            <h1 class="text-lg font-medium">Ecozen Solutions, Pune.</h1>
            <h2 class="text-base-content/70">Full Stack Web Developer</h2>
            <h2 class="text-base-content/70">Aug 2019 - Aug 2020</h2>
          </div>
          <ul class="ml-4 list-disc text-base-content/70">
            <li>
              Developed an IoT analytics dashboard using Vue.js, integrating
              with a backend REST API
            </li>
            <li>
              Created an MQTT client to process and store IoT data in MongoDB
            </li>
            <li>
              Implemented automated CRON jobs with email alerts for unexpected
              IoT device behavior
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
