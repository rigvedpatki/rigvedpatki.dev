---
import ExperienceIcon from '../assets/icons/solid/experience.svg';
import { organizations, roles } from '../data/portfolio';
---

<section
  id="experience"
  class="card bg-base-100 border border-base-300 shadow-sm"
>
  <div class="card-body">
    <h2 class="card-title text-2xl font-semibold flex items-center gap-3 mb-4">
      <ExperienceIcon
        class="h-7 w-7 shrink-0 fill-primary"
        aria-label="Experience icon"
      />
      Experience
    </h2>
    <div class="flex flex-col gap-y-4">
      {
        roles.map(role => {
          const organization = organizations[role.organizationId];

          return (
            <article class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-4">
              <div class="flex flex-col gap-y-2">
                <div class="flex flex-col gap-y-0.5">
                  <h3 class="text-lg font-medium">
                    {organization.name}, {organization.location}
                  </h3>
                  <p class="text-base-content/70">{role.title}</p>
                  <p class="text-base-content/70">{role.period.label}</p>
                </div>
                <p class="text-sm text-base-content/80 leading-relaxed">
                  {role.summary}
                </p>
                <ul class="ml-4 list-disc text-sm text-base-content/70 space-y-1">
                  {role.outcomes.map(outcome => (
                    <li>{outcome}</li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
