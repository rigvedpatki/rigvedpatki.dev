---
import EducationIcon from '../assets/icons/solid/education.svg';
import { education, institutions } from '../data/education';
---

<section
  id="education"
  class="card bg-base-100 border border-base-300 shadow-sm"
>
  <div class="card-body">
    <h2 class="card-title text-xl font-semibold flex items-center gap-2 mb-4">
      <EducationIcon
        class="h-7 w-7 shrink-0 fill-primary"
        aria-label="Education icon"
      />
      Education
    </h2>
    <div class="flex flex-col gap-y-4">
      {
        education.map(record => {
          const institution = institutions[record.institutionId];
          const institutionLabel = institution.location
            ? `${institution.name}, ${institution.location}`
            : institution.name;

          return (
            <article class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-3">
              <div class="flex flex-col gap-y-1.5">
                <div class="flex flex-col gap-y-0.5">
                  <h3 class="text-lg font-medium">{record.title}</h3>
                  <p class="text-base-content/70">{institutionLabel}</p>
                  <p class="text-base-content/70">{record.period.label}</p>
                </div>
                {(record.detail || record.projects) && (
                  <div class="flex flex-col gap-y-1.5">
                    {record.detail && (
                      <p class="text-base-content/70">{record.detail}</p>
                    )}
                    {record.projects && (
                      <>
                        <p class="text-base-content/70">Academic Projects:</p>
                        <ul class="ml-4 list-disc text-base-content/70">
                          {record.projects.map(project => (
                            <li>{project}</li>
                          ))}
                        </ul>
                      </>
                    )}
                  </div>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
