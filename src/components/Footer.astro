---
import LinkedInIcon from '../assets/icons/solid/likedin.svg';
import GitHubIcon from '../assets/icons/solid/github.svg';
---

<footer id="contact" class="mx-auto mt-24 w-full">
  <div class="border-t border-base-300 pt-5 pb-5">
    <div
      class="flex flex-col items-center gap-y-3 sm:flex sm:flex-row sm:items-center sm:justify-between sm:gap-y-0"
    >
      <div class="flex gap-x-4 text-sm">
        <!-- Add copyright notice here -->
        <span
          >© {new Date().getFullYear()} Rigved Patki. All rights reserved.</span
        >
      </div>
      <div class="flex items-center justify-between gap-x-2">
        <!-- Add Social Media Links Here -->
        <a
          href="https://www.linkedin.com/in/rigved-satish-patki/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-base-content/60 transition-all hover:text-base-content/40"
          aria-label="LinkedIn profile"
          data-analytics-event="social_click"
          data-analytics-social-network="LinkedIn"
          data-analytics-location="footer"
        >
          <LinkedInIcon
            class="h-4 w-4 shrink-0 fill-current"
            aria-hidden="true"
          />
        </a>
        <a
          href="https://github.com/rigvedpatki"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-base-content/60 transition-all hover:text-base-content/40"
          aria-label="GitHub profile"
          data-analytics-event="social_click"
          data-analytics-social-network="GitHub"
          data-analytics-location="footer"
        >
          <GitHubIcon
            class="h-4 w-4 shrink-0 fill-current"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </div>
</footer>
