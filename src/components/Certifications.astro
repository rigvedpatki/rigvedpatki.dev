---
import CertificateIcon from '../assets/icons/solid/certificate.svg';
---

<div class="card bg-base-100 border border-base-300 shadow-sm">
  <div class="card-body">
    <h2 class="card-title text-xl font-semibold flex items-center gap-2 mb-4">
      <CertificateIcon class="h-7 w-7 shrink-0 fill-primary" />
      Certifications
    </h2>
    <div
      class="relative rounded-2xl border border-base-300 bg-base-200 px-5 py-3"
    >
      <div class="flex flex-col gap-y-1.5">
        <ul class="ml-4 list-disc text-base-content/70">
          <li>
            Artificial Intelligence General Awareness | Veritas Technologies LLC
            | April 2024
          </li>
          <li>Go - The Complete Guide | Academind | February 2024</li>
          <li>
            Master NestJS - The JavaScript Node.js Framework | Udemy | September
            2021
          </li>
          <li>Angular: Securing Apps | LinkedIn | October 2020</li>
          <li>JavaScript: Security Essentials | LinkedIn | October 2020</li>
        </ul>
      </div>
    </div>
  </div>
</div>
