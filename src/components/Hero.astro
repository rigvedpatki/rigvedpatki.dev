---
import { Image } from 'astro:assets';
import ghibliProfile from '../assets/images/ghibli-profile.webp';
import resume from '../assets/resume/RigvedPatki.pdf';
import WorkIcon from '../assets/icons/solid/work.svg';
import PlaceIcon from '../assets/icons/solid/place.svg';
import LinkedInIcon from '../assets/icons/solid/likedin.svg';
import GitHubIcon from '../assets/icons/solid/github.svg';
import MailIcon from '../assets/icons/solid/mail.svg';
import { organizations } from '../data/portfolio';
---

<section class="flex flex-col items-center gap-y-7">
  <Image
    src={ghibliProfile}
    alt="Rigved Patki"
    width={168}
    height={168}
    densities={[1, 2]}
    class="h-42 w-auto rounded-full p-2"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="flex flex-col items-center gap-y-4">
    <h1 class="text-4xl font-bold">Rigved Patki</h1>
    <div class="max-w-2xl space-y-2 text-center">
      <p class="text-lg font-semibold">Senior Full-Stack Engineer</p>
      <p class="font-medium text-base-content/80">
        Frontend architecture, cloud-native systems, and technical leadership
      </p>
      <p class="text-base-content/70">
        9+ years building reliable product experiences for enterprise cloud and
        data platforms.
      </p>
    </div>
    <div class="flex flex-wrap justify-center gap-x-7 gap-y-3">
      <div class="flex flex-row items-center justify-center gap-x-2">
        <WorkIcon
          class="h-5 w-5 shrink-0 fill-primary"
          aria-label="Work icon"
        />
        <p>{organizations.cohesity.legalName}</p>
      </div>
      <div class="flex flex-row items-center justify-center gap-x-2">
        <PlaceIcon
          class="h-5 w-5 shrink-0 fill-primary"
          aria-label="Location icon"
        />
        <p>Pune, Maharashtra</p>
      </div>
    </div>
    <div class="flex flex-wrap justify-center gap-x-7 gap-y-3">
      <div class="tooltip" data-tip="Connect on LinkedIn">
        <a
          class="flex flex-row items-center justify-center gap-x-2 btn btn-ghost btn-circle"
          href="https://www.linkedin.com/in/rigved-satish-patki/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
          data-analytics-event="social_click"
          data-analytics-social-network="LinkedIn"
          data-analytics-location="hero"
        >
          <LinkedInIcon
            class="h-7 w-7 shrink-0 fill-primary"
            aria-hidden="true"
          />
        </a>
      </div>
      <div class="tooltip" data-tip="Connect on GitHub">
        <a
          class="flex flex-row items-center justify-center gap-x-2 btn btn-ghost btn-circle"
          href="https://github.com/rigvedpatki"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          data-analytics-event="social_click"
          data-analytics-social-network="GitHub"
          data-analytics-location="hero"
        >
          <GitHubIcon
            class="h-7 w-7 shrink-0 fill-primary"
            aria-hidden="true"
          />
        </a>
      </div>
      <div class="tooltip" data-tip="Connect on Email">
        <a
          class="flex flex-row items-center justify-center gap-x-2 btn btn-ghost btn-circle"
          href="mailto:rigved.patki@outlook.com"
          aria-label="Email contact"
          data-analytics-event="email_click"
          data-analytics-location="hero"
        >
          <MailIcon class="h-7 w-7 shrink-0 fill-primary" aria-hidden="true" />
        </a>
      </div>
    </div>
    <div class="flex flex-wrap justify-center gap-x-7 gap-y-3">
      <div class="flex flex-row items-center justify-center gap-x-2">
        <a
          href={resume}
          download="RigvedPatki-Resume.pdf"
          class="btn btn-primary flex items-center gap-2"
          data-analytics-event="file_download"
          data-analytics-file-name="RigvedPatki-Resume.pdf"
          data-analytics-file-type="pdf"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="currentColor"
              d="M12 15.248q-.161 0-.298-.053t-.267-.184l-2.62-2.619q-.146-.146-.152-.344t.152-.363q.166-.166.357-.169q.192-.003.357.163L11.5 13.65V5.5q0-.213.143-.357T12 5t.357.143t.143.357v8.15l1.971-1.971q.146-.146.347-.153t.366.159q.16.165.163.354t-.162.353l-2.62 2.62q-.13.13-.267.183q-.136.053-.298.053M6.616 19q-.691 0-1.153-.462T5 17.384v-1.923q0-.213.143-.356t.357-.144t.357.144t.143.356v1.923q0 .231.192.424t.423.192h10.77q.23 0 .423-.192t.192-.424v-1.923q0-.213.143-.356t.357-.144t.357.144t.143.356v1.923q0 .691-.462 1.153T17.384 19z"
            ></path></svg
          >
          Download Resume
        </a>
      </div>
    </div>
  </div>
</section>
